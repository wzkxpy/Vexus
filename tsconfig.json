{
  "compilerOptions": {
    /* 基础 */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],

    /* Vue / Vite */
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "allowJs": false,
    "isolatedModules": true,

    /* 类型安全 */
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,

    /* 路径 & 输出 */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Electron / Node */
    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ],

  "exclude": ["node_modules", "dist"]
}
